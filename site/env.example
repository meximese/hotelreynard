## Sanity - public frontend config
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-07-01"
NEXT_PUBLIC_SANITY_USE_CDN="false"

## Sanity visual editing
# Turn this on only where Presentation / Visual Editing should run.
NEXT_PUBLIC_SANITY_VISUAL_EDITING_ENABLED="true"
# Public Studio origin used by stega metadata and click-to-edit links.
# This is the Studio URL, not the site URL.
# Trailing slash is fine; runtime normalizes it away.
NEXT_PUBLIC_SANITY_STUDIO_URL="http://localhost:3333"

## Sanity - private frontend config
# Read token used by draft mode and preview fetches.
SANITY_API_READ_TOKEN="your-sanity-read-token"

## Optional app config
PUBLIC_SITE_URL="https://hotelreynard.com"
NEXT_PUBLIC_MEWS_CONFIGURATION_ID=""
