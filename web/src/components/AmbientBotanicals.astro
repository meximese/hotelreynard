---
import flowerOrangeA from "../assets/svg/orange flower a.svg?url";
import flowerOrangeB from "../assets/svg/orange flower b.svg?url";
import flowerOrangeC from "../assets/svg/orange flower c.svg?url";
import flowerOrangeD from "../assets/svg/orange flower d.svg?url";
import flowerRedA from "../assets/svg/red flower a.svg?url";
import flowerRedC from "../assets/svg/red flower c.svg?url";
import flowerWhiteA from "../assets/svg/white flower a.svg?url";
import flowerWhiteB from "../assets/svg/white flower b.svg?url";
import flowerWhiteC from "../assets/svg/white flower c.svg?url";
import leafGreenA from "../assets/svg/green leaf a.svg?url";
import leafGreenB from "../assets/svg/green leaf b.svg?url";
import leafGreenC from "../assets/svg/green leaf c.svg?url";
import leafOrangeA from "../assets/svg/orange leaf a.svg?url";
import leafRedA from "../assets/svg/red leaf a.svg?url";

const ambientBotanicals = [
  { id: "ambient-1", src: flowerWhiteA, alt: "White flower", size: 88, left: 3, duration: 20, delay: -12, drift: 38, rotate: -18, opacity: 0.52, scale: 0.86 },
  { id: "ambient-2", src: leafGreenA, alt: "Green leaf", size: 108, left: 10, duration: 23, delay: -4, drift: 26, rotate: 22, opacity: 0.38, scale: 0.92 },
  { id: "ambient-3", src: flowerOrangeB, alt: "Orange flower", size: 94, left: 17, duration: 18, delay: -15, drift: 34, rotate: -14, opacity: 0.48, scale: 0.82 },
  { id: "ambient-4", src: leafOrangeA, alt: "Orange leaf", size: 72, left: 24, duration: 16, delay: -6, drift: 42, rotate: 28, opacity: 0.44, scale: 0.88 },
  { id: "ambient-5", src: flowerRedA, alt: "Red flower", size: 82, left: 31, duration: 21, delay: -18, drift: 24, rotate: -24, opacity: 0.42, scale: 0.8 },
  { id: "ambient-6", src: leafGreenC, alt: "Green leaf", size: 102, left: 39, duration: 24, delay: -9, drift: 30, rotate: 18, opacity: 0.34, scale: 0.9 },
  { id: "ambient-7", src: flowerOrangeD, alt: "Orange flower", size: 90, left: 47, duration: 19, delay: -2, drift: 36, rotate: -16, opacity: 0.45, scale: 0.84 },
  { id: "ambient-8", src: leafRedA, alt: "Red leaf", size: 92, left: 55, duration: 22, delay: -11, drift: 28, rotate: 20, opacity: 0.31, scale: 0.86 },
  { id: "ambient-9", src: flowerWhiteC, alt: "White flower", size: 86, left: 63, duration: 17, delay: -14, drift: 40, rotate: -22, opacity: 0.49, scale: 0.78 },
  { id: "ambient-10", src: flowerOrangeA, alt: "Orange flower", size: 80, left: 71, duration: 20, delay: -8, drift: 26, rotate: 24, opacity: 0.46, scale: 0.8 },
  { id: "ambient-11", src: leafGreenB, alt: "Green leaf", size: 96, left: 78, duration: 25, delay: -19, drift: 32, rotate: -18, opacity: 0.33, scale: 0.88 },
  { id: "ambient-12", src: flowerRedC, alt: "Red flower", size: 84, left: 85, duration: 18, delay: -5, drift: 38, rotate: 16, opacity: 0.41, scale: 0.8 },
  { id: "ambient-13", src: flowerOrangeC, alt: "Orange flower", size: 92, left: 92, duration: 21, delay: -16, drift: 34, rotate: -20, opacity: 0.44, scale: 0.82 },
  { id: "ambient-14", src: flowerWhiteB, alt: "White flower", size: 86, left: 97, duration: 19, delay: -7, drift: 27, rotate: 18, opacity: 0.47, scale: 0.79 },
];
---

<div class="ambient-botanicals" aria-hidden="true">
  {ambientBotanicals.map((item) => (
    <figure
      class="ambient-botanicals__item"
      style={`--ambient-left:${item.left}vw; --ambient-size:${item.size}px; --ambient-duration:${item.duration}s; --ambient-delay:${item.delay}s; --ambient-drift:${item.drift}px; --ambient-rotate:${item.rotate}deg; --ambient-opacity:${item.opacity}; --ambient-scale:${item.scale};`}
    >
      <img src={item.src} alt={item.alt} loading="eager" />
    </figure>
  ))}
</div>

<style>
  .ambient-botanicals {
    inset: 0;
    overflow: clip;
    pointer-events: none;
    position: fixed;
    z-index: 0;
  }

  .ambient-botanicals__item {
    animation: ambient-botanicals-fall var(--ambient-duration) linear infinite;
    animation-delay: var(--ambient-delay);
    left: var(--ambient-left);
    margin: 0;
    opacity: var(--ambient-opacity);
    position: absolute;
    top: -18vh;
    transform: translate3d(0, -24vh, 0) rotate(0deg) scale(var(--ambient-scale));
    width: var(--ambient-size);
    will-change: transform;
  }

  .ambient-botanicals__item img {
    display: block;
    filter: drop-shadow(0 12px 18px rgba(120, 57, 52, 0.08));
    width: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-botanicals {
      display: none;
    }
  }

  @keyframes ambient-botanicals-fall {
    0% {
      transform: translate3d(0, -24vh, 0) rotate(0deg) scale(var(--ambient-scale));
    }

    25% {
      transform: translate3d(calc(var(--ambient-drift) * -0.5), 18vh, 0)
        rotate(calc(var(--ambient-rotate) * 0.4)) scale(var(--ambient-scale));
    }

    50% {
      transform: translate3d(var(--ambient-drift), 46vh, 0)
        rotate(calc(var(--ambient-rotate) * 0.7)) scale(var(--ambient-scale));
    }

    75% {
      transform: translate3d(calc(var(--ambient-drift) * -0.7), 74vh, 0)
        rotate(calc(var(--ambient-rotate) * 0.95)) scale(var(--ambient-scale));
    }

    100% {
      transform: translate3d(calc(var(--ambient-drift) * 0.35), 124vh, 0)
        rotate(var(--ambient-rotate)) scale(var(--ambient-scale));
    }
  }
</style>
