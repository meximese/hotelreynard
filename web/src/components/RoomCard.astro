---
import { urlFor } from "../utils/image";
import type { Room } from "../utils/sanity";

interface Props {
  room: Room;
}

const { room } = Astro.props;
---

<article class="content-card">
  {
    room.heroImage ? (
      <img
        alt={room.heroImage.alt || room.title}
        class="content-card__image"
        src={urlFor(room.heroImage).width(960).height(720).url()}
      />
    ) : (
      <div class="content-card__image content-card__image--empty"></div>
    )
  }
  <div class="content-card__body">
    <p class="content-card__eyebrow">Room</p>
    <h3>{room.title}</h3>
    {room.description ? <p>{room.description}</p> : null}
    {room.amenities?.length ? (
      <ul class="content-card__tags">
        {room.amenities.map((amenity) => <li>{amenity.title}</li>)}
      </ul>
    ) : null}
    <a class="content-card__link" href={`/rooms/${room.slug.current}`}>Explore room</a>
  </div>
</article>
