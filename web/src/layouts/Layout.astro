---
import { ViewTransitions } from 'astro:transitions';
import "../styles/site.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://api.mews.com/distributor/distributor.min.js"></script>
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__bar">
          <a class="site-header__brand" href="/">
            <span class="site-header__brand-mark">Hotel</span>
            <span class="site-header__brand-name">Reynard</span>
          </a>
          <nav class="site-header__nav" aria-label="Primary">
            <a href="/#rooms">Rooms</a>
            <a href="/#offers">Offers</a>
            <a href="/#contact">Contact</a>
          </nav>
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__panel">
          <p>302 Historic Columbia River Highway</p>
          <p>Troutdale, OR 97060</p>
          <p><a href="tel:+15037555302">+1 (503) 755-5302</a></p>
        </div>
      </footer>
    </div>
  </body>
</html>
