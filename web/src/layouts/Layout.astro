---
import { ViewTransitions } from 'astro:transitions';
import { VisualEditing } from '@sanity/astro/visual-editing';
import "../styles/site.css";
import { getPreviewModeEnabled } from "../utils/previewMode";

interface Props {
  title: string;
}

const { title } = Astro.props;
// Only activate the Sanity overlay client when the official preview-mode cookie is set.
const visualEditingEnabled = getPreviewModeEnabled(Astro.cookies);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {!visualEditingEnabled && <script is:inline src="https://api.mews.com/distributor/distributor.min.js"></script>}
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__bar">
          <a class="site-header__brand" href="/">
            <span class="site-header__brand-mark">Hotel</span>
            <img class="site-header__brand-logo" src="/logo-multi.png" alt="Hotel Reynard logo" alt="Reynard"/>
          </a>
          <nav class="site-header__nav" aria-label="Primary">
            <a href="/tavern">Eat and Drink</a>
            <a href="/rooms">Rest and Relax</a>
            <a href="/events">Throw a Party</a>
            <!-- <a href="/#rooms">Stay a While</a> -->
            <!-- <a href="/#contact">Contact</a> -->
          </nav>
        </div>
      </header>
      <main class="site-main">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__panel">
          <p>302 Historic Columbia River Highway</p>
          <p>Troutdale, OR 97060</p>
          <p><a href="tel:+15037555302">+1 (503) 755-5302</a></p>
        </div>
      </footer>
    </div>
    <VisualEditing enabled={visualEditingEnabled} zIndex={1200} />
  </body>
</html>
