---
import { ViewTransitions } from 'astro:transitions';
import { VisualEditing } from '@sanity/astro/visual-editing';
import "../styles/basic.css";
import { getPreviewModeEnabled } from "../utils/previewMode";
import logoTypeHotel from "../assets/svg/word-hotel.svg?url";
import logoTypeReynard from "../assets/svg/word-reynard.svg?url";
import AmbientBotanicals from "../components/AmbientBotanicals.astro";
import FooterWordmark from "../components/FooterWordmark.astro";
import observeCssVarScript from "../scripts/observe-css-var.ts?url";

interface Props {
  title: string;
}

const { title } = Astro.props;
// Only activate the Sanity overlay client when the official preview-mode cookie is set.
const visualEditingEnabled = getPreviewModeEnabled(Astro.cookies);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:wght@400;700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    {!visualEditingEnabled && <script is:inline src="https://api.mews.com/distributor/distributor.min.js"></script>}
    <title>{title}</title>
    <ViewTransitions />
  </head>
  <body>
    <div class="site-shell">
      <AmbientBotanicals />
      <div class="stripes">
        <div class="bar bar-a"></div>
        <div class="bar bar-b"></div>
        <div class="bar bar-c"></div>
        <div class="bar bar-a"></div>
        <div class="bar bar-b"></div>
        <div class="bar bar-c"></div>
      </div>
      <header>
        <div
          class="site-header__bar"
          data-css-var-dimension="height"
          data-css-var-name="--site-header-height"
          data-home-scroll-nav-state="hidden"
        >
          <nav class="site-header__nav site-header__nav--left" aria-label="Primary left">
            <a href="/tavern">Eat and Drink</a>
            <a href="/rooms">Rest and Relax</a>
          </nav>
          <a href="/" class="site-logo">
            <img src={logoTypeHotel} alt="Hotel" class="logo-hotel" width="50"/>
            <img src={logoTypeReynard} alt="Reynard" class="logo-reynard" width="100"/>
          </a>
          <nav class="site-header__nav site-header__nav--right" aria-label="Primary right">
            <a href="/events">Throw a Party</a>
            <a href="/journal">Journal</a>
          </nav>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer>
        <div>
          <FooterWordmark />
          <p>302 Historic Columbia River Highway</p>
          <p>Troutdale, OR 97060</p>
          <p><a href="tel:+15037555302">+1 (503) 755-5302</a></p>
        </div>
      </footer>
    </div>
    <script is:inline type="module" src={observeCssVarScript}></script>
    <VisualEditing enabled={visualEditingEnabled} zIndex={1200} />
  </body>
</html>
