---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";
import RichTextSection from "../../components/RichTextSection.astro";
import { urlFor } from "../../utils/image";
import { getRoom } from "../../utils/sanity";
import { getPreviewModeEnabled } from "../../utils/previewMode";

const { slug } = Astro.params;
const visualEditingEnabled = getPreviewModeEnabled(Astro.cookies);
const room = slug ? await getRoom(slug, { visualEditingEnabled }) : null;

if (!room) {
  return Astro.redirect("/");
}
---

<Layout title={`${room.title} | Hotel Reynard`}>
  <section class="detail-hero">
    <div>
      <p class="section-eyebrow">Room</p>
      <h1>{room.title}</h1>
      {room.description ? <p class="lede">{room.description}</p> : null}
      {
        room.amenities?.length ? (
          <ul class="detail-tags">
            {room.amenities.map((amenity) => <li>{amenity.title}</li>)}
          </ul>
        ) : null
      }
    </div>
    {
      room.heroImage ? (
        <img
          alt={room.heroImage.alt || room.title}
          class="detail-hero__image"
          src={urlFor(room.heroImage).width(1400).height(1000).url()}
        />
      ) : null
    }
  </section>

  {room.gallery?.length ? (
    <section class="gallery-grid">
      {room.gallery.map((image) => (
        <img
          alt={image.alt || room.title}
          class="gallery-grid__image"
          src={urlFor(image).width(1200).height(900).url()}
        />
      ))}
    </section>
  ) : null}

  <RichTextSection
    title="Plan your stay"
    value={[
      {
        _type: "block",
        children: [
          {
            _type: "span",
            text: room.mewsRoomCategoryId
              ? `This room is connected to Mews category ${room.mewsRoomCategoryId}.`
              : "Connect this room to a Mews category to align content with booking inventory.",
          },
        ],
      },
    ]}
  />
</Layout>
