---
export const prerender = false;

import ContactForm from "../components/ContactForm.astro";
import Layout from "../layouts/Layout.astro";
import MewsWidgetButton from "../components/MewsWidgetButton.astro";
import OfferCard from "../components/OfferCard.astro";
import RichTextSection from "../components/RichTextSection.astro";
import RoomCard from "../components/RoomCard.astro";
import { getOffers, getPageBySlug, getRooms } from "../utils/sanity";
import { getPreviewModeEnabled } from "../utils/previewMode";
import Newsletter from "../components/Newsletter.astro";

const visualEditingEnabled = getPreviewModeEnabled(Astro.cookies);
const [page, rooms, offers] = await Promise.all([
  getPageBySlug("home", { visualEditingEnabled }),
  getRooms({ visualEditingEnabled }),
  getOffers({ visualEditingEnabled }),
]);
---

<Layout title="Hotel Reynard">
  <section class="hero-grid">
    <div>
    {page?.body?.length ?
      <section class="rich-text-section">
        <RichTextSection title="Hotel Reynard" value={page.body} />
        <MewsWidgetButton enabled={!visualEditingEnabled} />
      </section>
      : null}
      <Newsletter />
    </div>
    <ContactForm />
  </section>

  <!-- <section class="section-panel" id="rooms">
    <p class="section-eyebrow">Rooms</p>
    <h2>Guest rooms mapped to Sanity content and Mews inventory</h2>
    <p class="lede">
      The room collection now comes from the sly schema set, so editorial copy
      and booking identifiers can live side by side.
    </p>
