---
export const prerender = false;

import Basic from "../layouts/Basic.astro";
import HomeScrollScene from "../components/HomeScrollScene.astro";
import Newsletter from "../components/Newsletter.astro";
---

<Basic title="Hotel Reynard">
  <HomeScrollScene />

  <section class="home-newsletter">
    <div class="home-newsletter__panel">
      <p class="home-newsletter__eyebrow">Stay In The Loop</p>
      <h2>Keep up with rooms, tavern nights, and openings at Reynard.</h2>
      <Newsletter />
    </div>
  </section>
</Basic>
